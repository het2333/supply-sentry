# Copy to infra/demo/.env only when managing the Compose stack manually.
# ./scripts/demo/demo.sh up generates strong local values automatically.
READYWORK_SESSION_SECRET=replace-with-64-hex-characters
READYWORK_INTERNAL_CALLBACK_TOKEN=replace-with-64-hex-characters
READYWORK_INTERNAL_TOKEN=replace-with-64-hex-characters
READYWORK_TEMPORAL_DB_PASSWORD=replace-with-a-strong-random-password
READYWORK_DEMO_BIND_ADDRESS=127.0.0.1
READYWORK_DEMO_PORT=3002
READYWORK_DEMO_IMAGE=ghcr.io/het2333/supply-sentry-demo:latest
