# Readywork Agent Kernel（默认使用 DeepSeek Harness）
READYWORK_AGENT_RUNTIME=dsh
READYWORK_DSH_REPO=/absolute/path/to/deepseek-harness
READYWORK_DSH_PROVIDER=deepseek-official
READYWORK_DSH_MODEL=deepseek-v4-flash
READYWORK_DSH_MAX_TOKENS=8192
# READYWORK_DSH_REASONING_EFFORT=medium # off|low|medium|high|max
# Worker profile overrides employee profile; both are server-only JSON config.
# READYWORK_DSH_AGENT_PROFILES={"employees":{"ai:procurement":{"model":"deepseek-v4-flash","reasoningEffort":"medium","maxTokens":4096}},"workers":{"invoice-match":{"model":"deepseek-v4","reasoningEffort":"high","maxTokens":8192}}}
DEEPSEEK_API_KEY=
# 仅 localhost/loopback 的兼容模型端点可在无 API Key 时运行。
# DEEPSEEK_BASE_URL=http://127.0.0.1:11434/v1
# Harness 默认只继承 PATH/TMP/LANG/TZ 等安全变量；确有需要时显式追加变量名。
# READYWORK_DSH_ENV_ALLOWLIST=HTTPS_PROXY,NO_PROXY

# Durable workflow runtime
# 本地独立栈：pnpm infra:temporal:up（gRPC 7233，UI http://127.0.0.1:18082）
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=readywork-workforce
# 仅供本地 Compose；生产环境必须替换为独立强密码。
READYWORK_TEMPORAL_DB_PASSWORD=
# READYWORK_TEMPORAL_PORT=7233
# READYWORK_TEMPORAL_UI_PORT=18082

# Production secrets: generate independent strong values; never commit real values.
READYWORK_SESSION_SECRET=
READYWORK_CREDENTIAL_KEY=

# 企业微信自建应用的公网 HTTPS 回调基地址。部署时由 TLS 反向代理把
# <此地址>/wecom/callback 转发到本机 127.0.0.1:8645；本地开发不要填写 127.0.0.1。
# READYWORK_HERMES_WECOM_CALLBACK_PUBLIC_URL=https://readywork.example.com

# 演示认证默认关闭。仅在本机 loopback 开发或启动验收时临时显式开启：
# READYWORK_DEMO_AUTH=1
# 不要将此变量写入部署配置；NODE_ENV=production 时演示认证会无条件被拒绝。
# 请使用临时环境变量，不要在此文件或任何版本库文件中写入演示密码、会话密钥或真实凭据。
